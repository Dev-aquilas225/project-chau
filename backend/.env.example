PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=aquilas

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Stripe configuration (dev / prod)
STRIPE_MODE=dev
STRIPE_SECRET_KEY_DEV=sk_test_mock
STRIPE_SECRET_KEY_PROD=
STRIPE_WEBHOOK_SECRET_DEV=whsec_mock
STRIPE_WEBHOOK_SECRET_PROD=

# SMTP (emails transactionnels : bienvenue, confirmation de commande, changement de
# statut, décision candidature vendeur). Si absent, les emails sont journalisés mais
# pas envoyés (pratique en dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@occasiondeluxepjinternational.com

# URL du site client, utilisée dans les liens des emails
FRONTEND_URL=http://localhost:5173

